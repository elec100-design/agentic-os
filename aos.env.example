# Agentic OS 개인 설정 — 이 파일을 aos.env 로 복사해 값을 채우세요.
#   cp aos.env.example aos.env
# aos.env 는 git 에 커밋되지 않으며(.gitignore), config.py 가 기동 시 읽습니다.
# 재설치·수동실행·launchd 어느 방식이든 여기 값이 적용됩니다.
# (실제 환경변수/export 가 있으면 그쪽이 우선합니다. 값에 = 이 있으면 그대로 두세요.)

# Obsidian 볼트(또는 임의 폴더) 루트. 지정 시 노트는 그 아래 "Agentic OS/" 에 저장.
# 미설정 시 저장소 안 data/notes/ 에 저장(Obsidian 불필요).
# AOS_VAULT_PATH=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/MyVault

# 노트 저장 폴더를 직접 지정(볼트 규칙 무시). 보통은 위 AOS_VAULT_PATH 만 씀.
# AOS_NOTES_DIR=/Users/you/notes

# 신뢰하는 프록시 호스트(콤마 구분). Tailscale serve 등으로 외부 접속 시 필요.
# 예: AOS_EXTRA_ORIGINS=myhost.tailnet.ts.net
# AOS_EXTRA_ORIGINS=

# 웹 서버 포트/호스트 (기본 8899 / 127.0.0.1). 호스트는 로컬 전용 유지 권장.
# AOS_PORT=8899
# AOS_HOST=127.0.0.1

# 파일 첨부 1건 최대 크기(MB, 기본 25)
# AOS_MAX_UPLOAD_MB=25

# launchd 서비스 레이블 (기본 com.agentic-os.dashboard)
# AOS_SERVICE_LABEL=com.agentic-os.dashboard
